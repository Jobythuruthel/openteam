{
  "extends": "@openteam/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
