# Copy to .env and adjust. Every variable is validated at startup by packages/config;
# the process exits with a list of problems if anything is missing or malformed.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL 16+. The database user needs permission to create the citext and pgcrypto extensions.
POSTGRES_USER=openteam
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=openteam
DATABASE_URL=postgresql://openteam:change-me-locally@localhost:5432/openteam

# Redis 7+ (BullMQ queues, rate limits, caching)
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=4000
APP_URL=http://localhost:3000
# Comma separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Set to true only when the API runs behind a reverse proxy you control
TRUST_PROXY=false

# Sessions and email tokens
# Must be true in production (served over HTTPS). The API refuses to start otherwise.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Worker
WORKER_CONCURRENCY=4

# Email delivery (worker). SMTP works with Mailpit locally and any relay in production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Open Team <no-reply@openteam.me>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Web and CMS (exposed to the browser, never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000
