{
  "name": "openteam",
  "private": true,
  "description": "Open Team: an open-source community, portfolio and jobs platform for AI creators and developers (openteam.me).",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** run build",
    "dev": "pnpm -r --parallel --filter=./apps/** run dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "db:generate": "pnpm --filter @openteam/database run generate",
    "db:migrate": "pnpm --filter @openteam/database run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @openteam/database run migrate:dev"
  },
  "devDependencies": {
    "@openteam/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "sharp",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
